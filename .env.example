# ========================================================
# VoiceBot AI — Environment Configuration
# ========================================================
# You can use any of the following API keys for generative AI responses.
# If no key is provided, the chatbot automatically uses the local
# trained BiLSTM deep learning model!

# Groq API Key (Recommended - ultra low latency, used in Ai_Mock_Interview)
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Google Gemini API Key
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=

# OpenAI API Key
# Get a key at https://platform.openai.com
OPENAI_API_KEY=

# Preferred Engine: "auto", "groq", "gemini", "openai", or "bilstm"
AI_ENGINE=auto
